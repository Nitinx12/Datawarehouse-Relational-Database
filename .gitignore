# ==========================
# Keep Empty Directories
# ==========================
!logs/.gitkeep
!output/.gitkeep
!exports/.gitkeep
# NOTE: bare __init__.py is ignored to keep namespace packages lean,
# but explicit package __init__.py under scripts/python and utils are
# required for `import scripts.python.*` and `import utils.*` to work
# on editable installs — re-allow those specific paths.
__init__.py
!scripts/__init__.py
!scripts/python/__init__.py
!utils/__init__.py
.qwen/
