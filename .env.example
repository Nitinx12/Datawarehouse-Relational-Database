#======================================
# Environment Variables
#=======================================
ENVIRONMENT=local
BUSINESS_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# =====================================
# Postgres Configuration
# =====================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=datawarehouse
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_SCHEMA_SOURCE=source
POSTGRES_SCHEMA_STAGING=staging
POSTGRES_SCHEMA_WAREHOUSE=warehouse
POSTGRES_SCHEMA_ANALYTICS=analytics

# =====================================
# MongoDB Configuration
# =====================================
MONGO_HOST=localhost
MONGO_DB=erp_source
MONGO_PORT=27017
MONGO_URL=

# =====================================
# Databricks Configuration
# =====================================
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=crm_source
DATABRICKS_PATH=

# =====================================
# Data Quality Gate
# =====================================
DQ_GATE_MIN_PASS_PCT=98.0


# ======================================
# ETL
# ======================================
ETL_BATCH_SIZE=10000
ETL_MAX_RETRIES=3
ETL_RETRY_DELAY_SECONDS=30