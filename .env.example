#======================================
# Environment Variables
#=======================================
ENVIRONMENT=local
BUSINESS_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# =====================================
# Postgres Configuration
# =====================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=datawarehouse
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_SCHEMA_SOURCE=source
POSTGRES_SCHEMA_STAGING=staging
POSTGRES_SCHEMA_WAREHOUSE=warehouse
POSTGRES_SCHEMA_ANALYTICS=analytics

# =====================================
# MongoDB Configuration
# =====================================
MONGO_HOST=localhost
MONGO_DB=erp_source
MONGO_PORT=27017
MONGO_URL=mongodb://localhost:27017/erp_source

# =====================================
# Databricks Configuration
# =====================================
DATABRICKS_HOST=change_me
DATABRICKS_TOKEN=change_me
DATABRICKS_CATALOG=crm_source
DATABRICKS_PATH=change_me

# =====================================
# Data Quality Gate
# =====================================
DQ_GATE_MIN_PASS_PCT=98.0


# ======================================
# ETL
# ======================================
ETL_BATCH_SIZE=10000
ETL_MAX_RETRIES=3
ETL_RETRY_DELAY_SECONDS=30

# ======================================
# Docker / Airflow (generate secrets, never commit real ones)
# Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ======================================
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=changeme-generate-with-cryptography-fernet
AIRFLOW_WEBSERVER_SECRET=changeme-generate-with-secrets-token_urlsafe
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme
DASHBOARD_PORT=8501
