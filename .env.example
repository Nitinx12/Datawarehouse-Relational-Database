#======================================
# Environment Variables
#=======================================
ENVIRONMENT=local
BUSINESS_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
LOG_DIR=logs

# =====================================
# Postgres Configuration
# =====================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=datawarehouse
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_SCHEMA_SOURCE=source
POSTGRES_SCHEMA_STAGING=staging
POSTGRES_SCHEMA_WAREHOUSE=warehouse
POSTGRES_SCHEMA_ANALYTICS=analytics

# =====================================
# MongoDB Configuration
# =====================================
MONGO_HOST=localhost
MONGO_DB=erp_source
MONGO_PORT=27017
MONGO_URL=mongodb://localhost:27017/erp_source

# =====================================
# Databricks Configuration
# =====================================
DATABRICKS_HOST=change_me
DATABRICKS_TOKEN=change_me
DATABRICKS_CATALOG=crm_source
DATABRICKS_PATH=change_me

# =====================================
# Data Quality Gate
# =====================================
DQ_GATE_MIN_PASS_PCT=98.0


# ======================================
# ETL
# ======================================
ETL_BATCH_SIZE=10000
ETL_MAX_RETRIES=3
ETL_RETRY_DELAY_SECONDS=30

# =====================================
# Airflow metadata DB (separate from the warehouse)
# =====================================
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_DB_NAME=airflow

# =====================================
# Airflow core (full AIRFLOW__ names pass straight into containers)
# Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =====================================
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__FERNET_KEY=change_me_generate_with_cryptography_fernet
AIRFLOW__WEBSERVER__SECRET_KEY=change_me_generate_with_secrets_token_urlsafe
# Shape only: compose rebuilds this from the DB parts above for containers.
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:change_me@airflow-metadata:5432/airflow

# Admin user (official compose names)
_AIRFLOW_WWW_USER_CREATE=true
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change_me

# =====================================
# Mail Alert Configuration
# =====================================
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False
AIRFLOW__SMTP__SMTP_USER=change_me
AIRFLOW__SMTP__SMTP_PASSWORD=change_me
AIRFLOW__SMTP__SMTP_MAIL_FROM=change_me

# =====================================
# DAG runtime (warehouse_daily.py)
# =====================================
ALERT_EMAILS=change_me
WAREHOUSE_CONN_ID=warehouse_postgres
AIRFLOW_CONN_WAREHOUSE_POSTGRES=postgresql://postgres:change_me@postgres:5432/datawarehouse

# =====================================
# Dashboard
# =====================================
DASHBOARD_PORT=8501

# =====================================
# Monitoring (Prometheus + Grafana)
# =====================================
EXPORTER_DB_PASSWORD=change_me
GRAFANA_DB_PASSWORD=change_me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
SMTP_USER=change_me
SMTP_PASSWORD=change_me
