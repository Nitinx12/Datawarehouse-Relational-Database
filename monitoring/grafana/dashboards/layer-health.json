          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "warehouse"
          },
          "format": "time_series",
          "rawSql": "SELECT\n    captured_at AS time,\n    layer || '.' || table_name AS metric,\n    row_count AS value\nFROM ops.table_snapshot\nWHERE $__timeFilter(captured_at)\n    AND layer = 'source'\nORDER BY 1;",
          "refId": "A"
        }
      ],
      "title": "Source rows over time",
      "type": "timeseries"
    },
